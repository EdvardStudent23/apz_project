# ─────────────────────────────────────────────────────────────────────────────
# NanoBank – Environment Variables
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────────────────────────

# Auth Service – JWT signing secret (must be the same across both instances)
JWT_SECRET=change_me_to_a_long_random_string

# Neo4j password for BankMarket
NEO4J_PASSWORD=change_me_neo4j
